# Optional overrides for `docker compose up`. Copy to `.env` and edit. Never commit the real file.
POSTGRES_USER=invoiceflow
POSTGRES_PASSWORD=change-me
JWT_SECRET=            # openssl rand -hex 32
JWT_REFRESH_SECRET=    # openssl rand -hex 32
ENCRYPTION_KEY=        # openssl rand -hex 32  (encrypts stored Gemini keys; changing it invalidates them)
AI_MODE=mock           # default for NEW workspaces; real Gemini is configured in Settings > AI
AI_MODEL=gemini-2.5-flash
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false    # set true behind HTTPS
SEED_DEMO_DATA=true    # set false in production
