# --- Core ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# --- Database / Redis ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoiceflow?schema=public
REDIS_URL=redis://localhost:6379

# --- Secrets (generate long random values: openssl rand -hex 32) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
# Encrypts stored credentials (e.g. Gemini keys) at rest. Changing it makes stored keys unreadable.
ENCRYPTION_KEY=

# --- AI ---
# mock = deterministic demo extraction (no key needed). gemini = real extraction (key set in Settings > AI).
AI_MODE=mock
AI_MODEL=gemini-2.5-flash

# --- Processing ---
# bullmq = Redis-backed queue (default). inline = process in-process (used by tests).
QUEUE_MODE=bullmq
RUN_WORKER=true
MAX_UPLOAD_MB=10
STORAGE_DIR=./storage
